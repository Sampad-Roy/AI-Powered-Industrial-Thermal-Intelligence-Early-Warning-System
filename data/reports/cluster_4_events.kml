        <color>ff00ffff</color>
        <scale>1.4</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/shapes/target.png</href>
        </Icon>
      </IconStyle>
    </Style>
    
    <!-- Cluster Centroid -->
    <Placemark>
      <name>Cluster 4 Centroid</name>
      <styleUrl>#centroidPoint</styleUrl>
      <description><![CDATA[
        <h3>Cluster 4 Geometric Centroid</h3>
        <p><b>Events in Cluster:</b> 25<br/>
        <b>Unique Dates:</b> 21 (81 days span: 2026-03-07 to 2026-05-27)<br/>
        <b>Mean Coordinates:</b> Lat 22.97941, Lon 72.56542<br/>
        <b>Mean FRP:</b> 1.46 MW<br/>
        <b>Mean Bright TI4:</b> 310.83 K<br/>
        <b>Mean Distance to Industry:</b> 388.9 m</p>
      ]]></description>
      <Point><coordinates>72.565416,22.979414,0</coordinates></Point>
    </Placemark>
    
